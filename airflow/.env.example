# Copy to airflow/.env. Astro loads it into every Airflow container.
#
# The Postgres warehouse runs in the repo's own docker-compose (container
# instacart_postgres, host port 5434). From inside the Astro containers the host is
# reachable as host.docker.internal on Docker Desktop.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5434
POSTGRES_DB=instacart_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Optional: post failure alerts to a Slack/Teams/Discord-style incoming webhook.
# Leave unset to only log alerts.
# AIRFLOW_VAR_ALERT_WEBHOOK_URL=

# Set after the Databricks Job exists (Jobs page -> job -> Job ID). Leave unset and the
# Databricks steps are skipped, so the dbt part can be tested on its own first.
# AIRFLOW_VAR_DATABRICKS_JOB_ID=

# Databricks connection. Fill these in on YOUR machine only; never commit .env.
# The token is a Databricks personal access token (User settings -> Developer).
# AIRFLOW_CONN_DATABRICKS_DEFAULT='{"conn_type": "databricks", "host": "https://<your-workspace>.cloud.databricks.com", "password": "<personal access token>"}'
