{
  "name": "instacart_lakehouse",
  "description": "Bronze -> silver -> gold Delta pipeline for the Instacart platform. Notebook tasks on serverless compute; logic in spark/instacart_spark.",
  "max_concurrent_runs": 1,
  "timeout_seconds": 14400,
  "parameters": [
    {
      "name": "mode",
      "default": "full"
    },
    {
      "name": "wave",
      "default": ""
    },
    {
      "name": "catalog",
      "default": "workspace"
    },
    {
      "name": "raw_path",
      "default": "/Volumes/workspace/instacart_bronze/raw"
    }
  ],
  "tasks": [
    {
      "task_key": "setup",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/{{YOUR_EMAIL}}/instacart-intelligence-platform/spark/notebooks/run_stage",
        "source": "WORKSPACE",
        "base_parameters": {
          "stage": "setup",
          "mode": "{{job.parameters.mode}}",
          "wave": "{{job.parameters.wave}}",
          "catalog": "{{job.parameters.catalog}}",
          "raw_path": "{{job.parameters.raw_path}}",
          "run_id": "{{job.run_id}}"
        }
      },
      "timeout_seconds": 3600
    },
    {
      "task_key": "bronze",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/{{YOUR_EMAIL}}/instacart-intelligence-platform/spark/notebooks/run_stage",
        "source": "WORKSPACE",
        "base_parameters": {
          "stage": "bronze",
          "mode": "{{job.parameters.mode}}",
          "wave": "{{job.parameters.wave}}",
          "catalog": "{{job.parameters.catalog}}",
          "raw_path": "{{job.parameters.raw_path}}",
          "run_id": "{{job.run_id}}"
        }
      },
      "timeout_seconds": 3600,
      "max_retries": 1,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": false,
      "depends_on": [
        {
          "task_key": "setup"
        }
      ]
    },
    {
      "task_key": "silver",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/{{YOUR_EMAIL}}/instacart-intelligence-platform/spark/notebooks/run_stage",
        "source": "WORKSPACE",
        "base_parameters": {
          "stage": "silver",
          "mode": "{{job.parameters.mode}}",
          "wave": "{{job.parameters.wave}}",
          "catalog": "{{job.parameters.catalog}}",
          "raw_path": "{{job.parameters.raw_path}}",
          "run_id": "{{job.run_id}}"
        }
      },
      "timeout_seconds": 3600,
      "max_retries": 1,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": false,
      "depends_on": [
        {
          "task_key": "bronze"
        }
      ]
    },
    {
      "task_key": "gold",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/{{YOUR_EMAIL}}/instacart-intelligence-platform/spark/notebooks/run_stage",
        "source": "WORKSPACE",
        "base_parameters": {
          "stage": "gold",
          "mode": "{{job.parameters.mode}}",
          "wave": "{{job.parameters.wave}}",
          "catalog": "{{job.parameters.catalog}}",
          "raw_path": "{{job.parameters.raw_path}}",
          "run_id": "{{job.run_id}}"
        }
      },
      "timeout_seconds": 3600,
      "max_retries": 1,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": false,
      "depends_on": [
        {
          "task_key": "silver"
        }
      ]
    },
    {
      "task_key": "quality",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/{{YOUR_EMAIL}}/instacart-intelligence-platform/spark/notebooks/run_stage",
        "source": "WORKSPACE",
        "base_parameters": {
          "stage": "quality",
          "mode": "{{job.parameters.mode}}",
          "wave": "{{job.parameters.wave}}",
          "catalog": "{{job.parameters.catalog}}",
          "raw_path": "{{job.parameters.raw_path}}",
          "run_id": "{{job.run_id}}"
        }
      },
      "timeout_seconds": 3600,
      "depends_on": [
        {
          "task_key": "gold"
        }
      ]
    },
    {
      "task_key": "optimize",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/{{YOUR_EMAIL}}/instacart-intelligence-platform/spark/notebooks/run_stage",
        "source": "WORKSPACE",
        "base_parameters": {
          "stage": "optimize",
          "mode": "{{job.parameters.mode}}",
          "wave": "{{job.parameters.wave}}",
          "catalog": "{{job.parameters.catalog}}",
          "raw_path": "{{job.parameters.raw_path}}",
          "run_id": "{{job.run_id}}"
        }
      },
      "timeout_seconds": 3600,
      "depends_on": [
        {
          "task_key": "quality"
        }
      ]
    }
  ],
  "tags": {
    "project": "instacart-intelligence-platform",
    "layer": "lakehouse"
  },
  "queue": {
    "enabled": true
  }
}
